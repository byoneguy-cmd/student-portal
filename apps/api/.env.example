# Приложение
NODE_ENV=development
PORT=3000
AUTH_ENABLED=true

# PostgreSQL
DATABASE_URL=postgresql://portal:portal@localhost:5432/student_portal?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# MinIO (S3)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_DOCUMENTS_BUCKET=documents

# RabbitMQ
RABBITMQ_URL=amqp://portal:portal@localhost:5672

# OpenSearch
OPENSEARCH_URL=http://localhost:9200

# Keycloak (OIDC)
KEYCLOAK_ISSUER=http://localhost:8080/realms/student-portal
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/student-portal/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=portal-api

# Криптография ПДн (HMAC для iin_token, AES-256-GCM для шифрования ИИН)
PDN_HMAC_SECRET=change-me-hmac-secret-32-bytes-min
PDN_AES_KEY=change-me-aes-256-key-32-bytes

# Внешние интеграции (точные URL — по договору с оператором)
EGOV_BASE_URL=
ESH_EP_BASE_URL=
SMART_DATA_URL=
NOBD_URL=
SKUD_BASE_URL=
CANTEEN_BASE_URL=
PAY_GATEWAY_URL=
NUC_OCSP_URL=
NUC_CRL_URL=
