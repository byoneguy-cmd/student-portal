// =====================================================================
// Prisma-схема «Единый студенческий портал» (Student Super-App)
// Источник истины DDL: docs/02-database.md
// Prisma 6 (multiSchema). PostgreSQL 16.
//
// ВАЖНО:
// 1. Канонический DDL (ENUM-типы в схемах, CHECK-ограничения, триггеры,
//    GIN-индексы, частичные индексы, партиционирование) находится в
//    raw-SQL миграциях каталога migrations/ (V001..V012). Prisma здесь —
//    только рантайм-ORM/генератор клиента, а НЕ источник миграций.
// 2. ENUM-ы объявлены БЕЗ @@schema (тип в схеме public по умолчанию).
//    Фактические PostgreSQL ENUM-типы создаются в своих схемах через
//    V002__enums.sql (iam.user_status, doc.document_status и т.д.);
//    для `prisma generate` колонка модели и enum не обязаны лежать в
//    одной PostgreSQL-схеме.
// 3. GIN-индексы (jsonb_path_ops), частичные уникальные индексы и
//    CHECK-ограничения не представимы в Prisma — отмечены комментариями
//    «только в raw SQL» и реализованы в миграциях.
// =====================================================================

generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["iam", "doc", "acc", "social", "acad", "svc", "notif", "ops", "public"]
}

// =====================================================================
// ENUM-типы (раздел 3.1 docs/02-database.md)
// Имя Prisma-enum = PascalCase имени PostgreSQL-типа без схемы.
// =====================================================================

// ---- IAM ----
enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  GRADUATED
  EXPELLED
  ARCHIVED
  @@schema("iam")
}
enum IdentityProvider {
  EGOV_MOBILE
  NCALAYER
  PASSWORD
  KEYCLOAK_SSO
  EXTERNAL_LMS
  @@schema("iam")
}
enum IdentityStatus {
  LINKED
  UNLINKED
  SUSPENDED
  @@schema("iam")
}
enum RoleType {
  STUDENT
  LECTURER
  DEANERY
  FINANCE
  DORM_ADMIN
  CANTEEN_ADMIN
  ADMIN
  @@schema("iam")
}
enum ImportSource {
  SMART_DATA_UKIMET
  NOBD
  EGOV_MOBILE
  GBD_FL
  GBD_RN
  MTSZN
  MZ
  MANUAL
  @@schema("iam")
}
enum ImportStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  PARTIAL
  @@schema("iam")
}
enum ConsentStatus {
  GRANTED
  REVOKED
  EXPIRED
  @@schema("iam")
}
enum ConsentScope {
  PROFILE
  DOCUMENTS
  ACCOMMODATION
  SOCIAL_BENEFITS
  ACADEMIC
  MEDICAL
  FINANCIAL
  ALL
  @@schema("iam")
}

