{
  "name": "student-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Единый студенческий портал безбумажного вуза (Student Super-App), РК",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev:api": "pnpm --filter @sp/api start:dev",
    "dev:web": "pnpm --filter @sp/web dev",
    "start:api": "pnpm --filter @sp/api start:prod",
    "prisma:generate": "pnpm --filter @sp/api prisma:generate",
    "lint": "pnpm -r lint"
  }
}
